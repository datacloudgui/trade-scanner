{
  "bucket_thresholds": { "near": 0.005, "mild": 0.03, "extended": 0.10 },
  "environments": {
    "dev":  {
      "top_n": 2,
      "max_universe": 4,
      "universe": "sample_dev",
      "timeframes": { "D": [8, 20, 200], "W": [8, 20, 200], "M": [8, 20, 200] },
      "warmup_budget": { "daily": 4300 },
      "validate_warmup": true,
      "sma_validation": true
    },
    "prod": {
      "top_n": 50,
      "max_universe": 200,
      "warmup_budget": { "daily": 1100 }
    }
  },
  "strategies": {
    "swing_eod": {
      "enabled": true,
      "universe": "swing_advances",
      "direction": "long",
      "main_timeframe": "W",
      "timeframes": { "D": [8, 20, 200], "W": [8, 20, 200], "M": [8, 20] },
      "schedule": "after_close",
      "universe_filter": "avg_vol > 1e6 and price > 5",
      "filters": {
        "W:8": ["near"],
        "W:20": ["near", "above_mild"],
        "M:20": ["near", "above_mild"],
        "D:8": ["near", "above_mild"],
        "D:20": ["near", "above_mild", "above_strong", "extended_above"]
      }
    },
    "swing_eod_short": {
      "enabled": false,
      "universe": "swing_declines",
      "direction": "short",
      "main_timeframe": "W",
      "timeframes": { "D": [8, 20, 200], "W": [8, 20, 200], "M": [8, 20] },
      "schedule": "after_close",
      "universe_filter": "avg_vol > 1e6 and price > 5"
    },
    "market_close": {
      "enabled": false,
      "universe": "swing_advances",
      "direction": "long",
      "main_timeframe": "W",
      "timeframes": { "D": [8, 20, 200], "W": [8, 20, 200], "M": [8, 20] },
      "schedule": "before_close_30m",
      "universe_filter": "avg_vol > 1e6 and price > 5"
    },
    "market_close_short": {
      "enabled": false,
      "universe": "swing_declines",
      "direction": "short",
      "main_timeframe": "W",
      "timeframes": { "D": [8, 20, 200], "W": [8, 20, 200], "M": [8, 20] },
      "schedule": "before_close_30m",
      "universe_filter": "avg_vol > 1e6 and price > 5"
    }
  }
}
